# 注释：以 # 开头的行是注释，不会生效

# 忽略操作系统临时文件
.DS_Store
Thumbs.db
*.tmp

# 忽略编辑器配置文件
.idea/
.vscode/
*.sublime-*
*.swp

# 忽略编程语言/框架的依赖/编译文件
node_modules/
.venv/
__pycache__/
target/
dist/
build/
.next/
webui/.next/
webui/next-env.d.ts
*.log
*.lock

# 本地数据/生成目录
server/vectorstore/
server/chromastore/
server/__pycache__/
loginserver/__init__.py


# MCP dev JWT keypair (generated locally)
# 环境变量文件（包含密钥、数据库信息等）
.env
.pycache
.pycache_tmp

